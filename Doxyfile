# Demi God C++ 클라이언트 포트폴리오 API 문서 설정
# 저장소 루트에서 doxygen Doxyfile 실행

PROJECT_NAME           = "Demi God"
PROJECT_BRIEF          = "C++17 게임 클라이언트 핵심 시스템 포트폴리오"
OUTPUT_DIRECTORY       = build/doxygen
OUTPUT_LANGUAGE        = Korean
INPUT_ENCODING         = UTF-8

INPUT                  = README.md basicType.h demi_god.cpp game
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp *.md
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES

# 모든 클래스와 공개/비공개 멤버를 문서에 포함한다.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
SEARCHENGINE           = YES

# Graphviz(dot)가 설치되어 있으면 클래스 상속 및 의존성 그래프 생성.
# Graphviz가 없는 환경에서는 HAVE_DOT을 NO로 변경한다.
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
